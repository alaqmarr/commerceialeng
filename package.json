{
  "name": "commercial-engineering-associates",
  "version": "1.0.0",
  "private": true,
  "description": "Commercial Engineering Associates - Industrial Tapes, Sealants, Adhesives Catalog & Enquiry Portal",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "update": "git stash && git pull && npm i --legacy-peer-deps && npx prisma generate && npx prisma db push && npm run build && pm2 restart ce",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:generate": "prisma generate",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "test:e2e": "playwright test",
    "test:lines": "tsx scripts/validate-module-line-limits.ts",
    "test:domain": "tsx scripts/validate-domain-extraction.ts",
    "test:architecture": "tsx scripts/validate-module-line-limits.ts && tsx scripts/validate-domain-extraction.ts && tsx scripts/validate-analytics-architecture.ts",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:report": "playwright show-report"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1147.0",
    "@libsql/client": "^0.18.0",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "clsx": "^2.1.1",
    "dotenv": "^18.0.6",
    "lucide-react": "^1.52.0",
    "next": "16.4.0",
    "next-auth": "4.24.15",
    "nodemailer": "^6.10.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-dropzone": "20.1.2",
    "sqlite": "^5.1.1",
    "sqlite3": "^6.0.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^22.13.0",
    "@types/nodemailer": "^6.4.17",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "postcss": "^8.5.1",
    "prisma": "^7.10.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
